L  14      Class Config public class Config {
    /** Whether verbose logging is enabled. */
    public boolean verbose;
    /** Maximum depth for recursive parsing. */
    public int maxDepth;

    /** Creates a new configuration with default settings. */
    public Config() {
        this.verbose = false;
        this.maxDepth = 10;
    }
