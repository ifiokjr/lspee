L  63   Function parseJson function parseJson<T>(input: string): ProcessResult<T> {
  try {
    const data = JSON.parse(input) as T;
    return { ok: true, data };
  } catch (e) {
    return { ok: false, error: String(e) };
  }
} // Parse a JSON string into a typed result. */
